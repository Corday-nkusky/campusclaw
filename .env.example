# CampusClaw 迭代 1 · 配置样例
#
# 用法：复制为 .env 并填写真实值。.env 不入库。
#      cp .env.example .env
#
# 说明：本文件列出**全部必填项**。任一项缺失时代码启动失败并退出，
#      不落到任何内置默认值 —— 见 design.md D7、spec.md R7.1。

# ── JWT 签发（必填，缺失即启动失败）────────────────────────
# JWT 的 HMAC-SHA256 签名密钥（add-token-auth：配置名沿用 SESSION_SECRET）。
# 生成方式：openssl rand -hex 32
# 绝对不要提交真实值，也不要在镜像里内置。
SESSION_SECRET=

# access token 有效期（小时）。add-refresh-token 起降级为**兼容回退**：
# 仅当 ACCESS_TTL_MINUTES 未设置时用于推导 access TTL，不再推荐直接使用。
SESSION_TTL_HOURS=24

# ── 双令牌 TTL（add-refresh-token，选填，有默认值）──────────────
# access token 有效期（分钟）。默认 15；设置后覆盖 SESSION_TTL_HOURS 的推导。
# 短 access + refresh 的静默续期，是「在用不掉线且泄露窗口小」的关键。
ACCESS_TTL_MINUTES=15

# refresh token 有效期（天）。默认 30。过期后须重新登录。
REFRESH_TTL_DAYS=30

# ── 检索依赖（add-class-scoped-retrieval R8.1：缺任一项启动失败）──
# 嵌入网关：OpenAI 兼容 POST {EMBEDDING_API_BASE}/v1/embeddings
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 嵌入向量维度，必须与模型实际输出一致（如 bge-m3=1024、text-embedding-3-small=1536）
EMBEDDING_DIM=
# 对话网关：OpenAI 兼容 POST {CHAT_API_BASE}/v1/chat/completions（非流式）
CHAT_API_BASE=
CHAT_API_KEY=
CHAT_MODEL=
# Qdrant（仅服务端访问，不向浏览器暴露）
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=campusclaw_chunks

# ── 数据库（必填）──────────────────────────────────────────
# 注意：宿主机直跑时用 127.0.0.1:3306；Compose 内应填服务名 db:3306。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=

# ── 上传（必填）────────────────────────────────────────────
# 上传目录。容器内为 /app/uploads；宿主机直跑时给绝对路径。
# 值含空格时必须加引号，否则 `source .env`（见 scripts/dev-run.sh）会被 shell 拆词。
UPLOAD_DIR=./uploads

# 单文件大小上限（字节）。默认 2 MiB。
MAX_UPLOAD_BYTES=2097152

# ── 预置账号口令（必填，种子初始化时写入 bcrypt 哈希）───────
# 种子的三个账号：
#   teacher_a   教师 · A 班
#   student_a1  学生 · A 班
#   student_b1  学生 · B 班
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# ── 登录失败限流（必填）────────────────────────────────────
# 同一「用户名 + IP」在窗口内连续失败达到阈值即锁定。
LOGIN_FAIL_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# ── 服务监听 ───────────────────────────────────────────────
# 本机开发固定 18080，避开默认 8080 与系统上其它服务冲突。
# 部署侧 compose.yaml 写死容器内 8080，改这里只影响本机直跑后端。
API_PORT=18080
